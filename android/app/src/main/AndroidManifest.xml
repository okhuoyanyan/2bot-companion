<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    package="com.twobot.companion">

    <!-- 基础网络权限 -->
    <uses-permission android:name="android.permission.INTERNET"/>
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE"/>
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE"/>

    <!-- Android 10+ 获取当前连接 WiFi SSID 必需的位置权限 -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION"/>
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION"/>

    <!-- 前台服务与常驻保活权限 (WO-75-R2: dataSync → specialUse——dataSync 在 Android 15 有 6h/日上限,
         跨晨长跑必被 ForegroundServiceDidNotStopInTime 掐断; specialUse 无时限) -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE"/>
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE"/>
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>
    <uses-permission android:name="android.permission.WAKE_LOCK"/>
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED"/>
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS"/>

    <!-- WO-69 日历自动同步：仅读写自建本地日历 (ACCOUNT_TYPE=2bot.local)，严禁触碰用户其它日历 -->
    <uses-permission android:name="android.permission.READ_CALENDAR"/>
    <uses-permission android:name="android.permission.WRITE_CALENDAR"/>

    <!-- Android 10+ 步数传感器所需活动识别权限 -->
    <uses-permission android:name="android.permission.ACTIVITY_RECOGNITION"/>
    <!-- 检查与管理勿扰模式 (DND) 必需 -->
    <uses-permission android:name="android.permission.ACCESS_NOTIFICATION_POLICY"/>
    <!-- 查询系统使用情况 (屏幕使用时长，由用户在系统设置中自主授权，可选) -->
    <uses-permission android:name="android.permission.PACKAGE_USAGE_STATS" tools:ignore="ProtectedPermissions"/>

    <application
        android:label="2BOT 伴侣"
        android:name=".MainApplication"
        android:icon="@mipmap/ic_launcher"
        android:usesCleartextTraffic="true">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>

        <!-- flutter_foreground_task 前台常驻保活服务 (WO-75-R2: specialUse 类型——
             插件 8.17.0 经 ServiceInfo.FOREGROUND_SERVICE_TYPE_MANIFEST 采信此声明,
             Dart 侧无类型参数) -->
        <service
            android:name="com.pravera.flutter_foreground_task.service.ForegroundService"
            android:foregroundServiceType="specialUse"
            android:exported="false" />

        <!-- WO-75-R2: specialUse 用途声明（系统/应用商店审核可读）：
             设备状态遥测中继 + 日历 WebDAV/IMAP 双通道常驻同步，
             用户显式开启的 7x24 保活语义，dataSync 6h 上限与之本质冲突 -->
        <property
            android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
            android:value="User-enabled persistent device-telemetry relay and calendar sync keepalive (7x24 by design; Android 15 dataSync 6h cap conflicts with the always-on contract the user explicitly opted into)" />

        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>
</manifest>
